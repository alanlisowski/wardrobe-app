{
  "expo": {
    "name": "Wardrobe",
    "slug": "wardrobe-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "wardrobe",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Wardrobe uses the camera to photograph your clothes."
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
