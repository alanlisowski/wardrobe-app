{
  "name": "wardrobe-app",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "infra:up": "docker compose up -d postgres redis minio ml",
    "infra:down": "docker compose down",
    "dev:api": "pnpm --filter @wardrobe/api dev",
    "dev:worker": "pnpm --filter @wardrobe/worker dev",
    "dev:mobile": "pnpm --filter @wardrobe/mobile start",
    "db:generate": "pnpm --filter @wardrobe/db generate",
    "db:migrate": "pnpm --filter @wardrobe/db migrate",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
